pipeline {
    agent any

    environment {
        // Define Docker image name (replace <roll_no> or user details as needed)
        DOCKER_IMAGE = "madhavmurali/wine-quality"
        DOCKER_TAG = "${BUILD_NUMBER}"
        // Variable to control conditional steps
        SHOULD_PUBLISH = "false"
    }

    stages {
        stage('Checkout') {
            steps {
                // Checkout from SCM (GitHub)
                checkout scm
            }
        }

        stage('Setup Python Virtual Environment') {
            steps {
                sh '''
                    # Create virtual environment
                    python3 -m venv venv
                    
                    # Activate and install dependencies
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Train Model') {
            steps {
                sh '''
                    . venv/bin/activate
                    
                    # Execute training script
                    python src/training.py
                    
                    # Prepare artifacts directory required by Lab 6
                    mkdir -p app/artifacts
                    
                    # Move generated artifacts from default 'models/' to 'app/artifacts/'
                    # Adjust header/format if necessary, but copying is safest to preserve originals
                    cp models/metrics.json app/artifacts/
                    cp models/model.pkl app/artifacts/
                '''
            }
        }

        stage('Read Accuracy') {
            steps {
                script {
                    // Extract R2_Score using python for robustness (avoidsjq dependency if not installed)
                    env.CURRENT_ACCURACY = sh(
                        script: "python3 -c 'import json; print(json.load(open(\"app/artifacts/metrics.json\"))[\"r2_score\"])'",
                        returnStdout: true
                    ).trim()
                    
                    echo "Current Accuracy (R2 Score): ${env.CURRENT_ACCURACY}"
                }
            }
        }

        stage('Compare Accuracy') {
            steps {
                script {
                    // Initialize BEST_ACCURACY
                    env.BEST_ACCURACY = "0.0"
                    
                    // Try to read from credentials
                    try {
                        withCredentials([string(credentialsId: 'best-r2-score', variable: 'STORED_BEST')]) {
                            if (STORED_BEST?.trim()) {
                                env.BEST_ACCURACY = STORED_BEST
                            }
                        }
                    } catch (Exception e) {
                        echo "Credential 'best-r2-score' not found or empty. Comparison will be against 0.0."
                    }

                    echo "Best Accuracy stored: ${env.BEST_ACCURACY}"

                    def currentAcc = env.CURRENT_ACCURACY.toFloat()
                    def bestAcc = env.BEST_ACCURACY.isNumber() ? env.BEST_ACCURACY.toFloat() : 0.0

                    if (currentAcc > bestAcc) {
                        echo "SUCCESS: New model (${currentAcc}) is better than baseline (${bestAcc})."
                        env.SHOULD_PUBLISH = "true"
                    } else {
                        echo "SKIP: New model (${currentAcc}) is not better than baseline (${bestAcc})."
                        env.SHOULD_PUBLISH = "false"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            when {
                expression { return env.SHOULD_PUBLISH == "true" }
            }
            steps {
                script {
                    echo "Building Docker image..."
                    // Assumes Docker Pipeline plugin is installed
                    // Using the Dockerfile in the root of the repo
                    dockerImage = docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                }
            }
        }

        stage('Push Docker Image') {
            when {
                expression { return env.SHOULD_PUBLISH == "true" }
            }
            steps {
                script {
                    echo "Pushing Docker image to Docker Hub..."
                    docker.withRegistry('', 'dockerhub-creds') {
                        dockerImage.push()
                        dockerImage.push('latest')
                    }
                }
            }
        }
    }

    post {
        always {
            // Archive artifacts regardless of success/failure
            archiveArtifacts artifacts: 'app/artifacts/**', fingerprint: true
            echo "Artifacts archived in 'app/artifacts/'"
        }
    }
}
